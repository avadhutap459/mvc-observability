            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "department": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "salary": {
            "maximum": 100000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "UploadChunkRequest": {
